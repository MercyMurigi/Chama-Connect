# Local: copy to `.env.local` (recommended) or `.env`. Do not commit real secrets.

# =============================================================================
# LLM API keys (at least one of GEMINI/GOOGLE or ANTHROPIC required for Copilot)
# =============================================================================
# GEMINI_API_KEY: Used by Vite (injected for the client bundle) and the Express server.
GEMINI_API_KEY=

# GOOGLE_API_KEY: Alternate name for the same Gemini key (server only).
GOOGLE_API_KEY=

# LLM_PROVIDER: gemini | anthropic | openrouter — drives /api/llm/*; Copilot supports gemini or anthropic.
LLM_PROVIDER=gemini

# ANTHROPIC_API_KEY: Claude for Copilot (when LLM_PROVIDER=anthropic) and /api/llm.
ANTHROPIC_API_KEY=

# OPENROUTER_API_KEY: OpenAI-compatible /api/llm only (not used by Copilot BuiltInAgent).
OPENROUTER_API_KEY=

# =============================================================================
# Model IDs (optional; defaults match server/src/llm/complete.ts)
# =============================================================================
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OPENROUTER_MODEL=openai/gpt-4o-mini

# =============================================================================
# Ports and Vite
# =============================================================================
# API_PORT: Express listen port AND the port Vite proxies /api to (default 3001).
# Do not set API_PORT or PORT to 3000 while Vite runs on 3000 — the proxy would
# target Vite itself and Copilot returns 404 for /api/copilotkit.
API_PORT=3001
# PORT: optional legacy alias for the API port if API_PORT is unset.
PORT=3001

# DISABLE_HMR: set to true in hosted sandboxes (e.g. AI Studio) to turn off HMR/file watching.
# DISABLE_HMR=

# =============================================================================
# Vercel (production)
# =============================================================================
# Deploy with the Vercel Git integration or `vercel`. The app uses one serverless
# function at api/[[...slug]].ts so /api/copilotkit, /api/health, /api/llm/* all work.
# In the Vercel project → Settings → Environment Variables, set at least:
#   GEMINI_API_KEY (or GOOGLE_API_KEY) — required for Chama AI / CopilotKit
# Optional: ANTHROPIC_API_KEY, LLM_PROVIDER, etc. (same as local)
# CopilotKit uses relative URLs (/api/copilotkit); no extra PUBLIC_* URL needed.
# If AI replies time out, raise the function cap in vercel.json or upgrade plan limits.
